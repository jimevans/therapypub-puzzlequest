{
  // Type-checks the server code (`npm run typecheck`). Files that are still
  // JavaScript get their types from JSDoc annotations and the libraries' type
  // definitions. tsconfig.build.json extends this to compile src/ to dist/.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.ts", "src/**/*.js", "*.js"],
  // Browser scripts read globals that each EJS page defines, so they are not
  // checked yet. Tests are not checked yet either. src/loader.cjs, the hosting
  // startup file, is not checked because it imports the build output in dist/,
  // which doesn't exist until after `npm run build`.
  "exclude": ["src/public/**"]
}
