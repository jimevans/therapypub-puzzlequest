{
  // Type-checks the server code, which is still JavaScript; converting it to
  // TypeScript files has not been decided yet. Types come from JSDoc
  // annotations and the libraries' type definitions. Nothing is emitted: the
  // deployment runs the source as-is.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.js", "src/**/*.cjs", "src/**/*.d.ts", "*.js"],
  // Browser scripts read globals that each EJS page defines, so they are not
  // checked yet. Tests are not checked yet either.
  "exclude": ["src/public/**"]
}
