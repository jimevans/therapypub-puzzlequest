{
  // Type-checks the server code (`npm run typecheck`). Files that are still
  // JavaScript get their types from JSDoc annotations and the libraries' type
  // definitions. tsconfig.build.json extends this to compile src/ to dist/.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.js", "src/**/*.cjs", "src/**/*.d.ts", "*.js"],
  // Browser scripts read globals that each EJS page defines, so they are not
  // checked yet. Tests are not checked yet either.
  "exclude": ["src/public/**"]
}
