{
  // Type-checks the server code and tests, which stay JavaScript: Node 20
  // cannot run .ts files, and the deployment copies the source as-is. Types
  // come from JSDoc annotations and the libraries' type definitions.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.js", "src/**/*.cjs", "src/**/*.d.ts", "*.js"],
  // Browser scripts read globals that each EJS page defines, so they are not
  // checked yet. Tests are not checked yet either.
  "exclude": ["src/public/**"]
}
