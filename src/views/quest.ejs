<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>PuzzleQuest</title>
    <link rel="stylesheet" type="text/css" href="/style/pq.css" />
    <link rel="icon" type="image/png" href="/image/pq-logo-64.png" sizes="64x64 32x32 24x24 16x16" />
    <link rel="icon" type="image/png" href="/image/pq-logo-192.png" sizes="192x192" />
  </head>
  <body>
    <nav class="pq-navigation">
      <div class="pq-navigation-header">
        <input id="nav-checkbox" type="checkbox" class="pq-nav-checkbox"/>
        <label for="nav-checkbox">
          <div class="pq-nav-icon-button">
            <svg viewBox="0 0 512 512">
              <use xlink:href="/image/menu-burger.svg#menu" href="/image/menu-burger.svg#menu"></use>
            </svg>
          </div>
        </label>
        <ul class="pq-navigation-title">
          <li><%= quest.displayName %></li>
        </ul>
        <div class="pq-menu">
          <ul>
            <li>
              <a href="/" class="pq-menu-link">Return to dashboard</a>
            </li>
            <li>
              <a href="/user/<%=userName%>" class="pq-menu-link">View user profile</a>
            </li>
            <li>
              <a href="/logout" class="pq-menu-link">Sign out</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="pq-nav-button-bar">
        <a href="/">
          <div class="pq-nav-icon-button">
            <svg viewBox="0 0 512 512">
              <use xlink:href="/image/arrow-left.svg#arrow-left" href="/image/arrow-left.svg#arrow-left"></use>
            </svg>
          </div>
        </a>
      </div>
    </nav>
    <div id="quest-progress" class="pq-quest">
      <div class="pq-quest-link">
        <strong>Quest</strong>
      </div>
      <div class="pq-quest-status">
        <%= quest.statusDescription %>
      </div>
      <%- include("partials/progressTimes", { progress, kind: "quest", timeClass: "pq-quest-time" }) %>
    </div>
    <div id="puzzles">
      <% quest.puzzles.filter((puzzle) => puzzle.status > 0).forEach((puzzle) => { %>
      <div class="pq-quest-puzzle" data-puzzle-name="<%=puzzle.puzzleName%>">
        <div class="pq-quest-puzzle-link">
          <a href="/quest/<%=quest.name%>/puzzle/<%=puzzle.puzzleName%>"><%= puzzle.puzzleDetail.displayName %></a>
        </div>
        <div class="pq-quest-puzzle-status">
          <span><%= puzzle.statusDescription %></span>
        </div>
        <% const puzzleProgress = progress.puzzles.find((p) => p.puzzleName === puzzle.puzzleName); %>
        <%- include("partials/progressTimes", { progress: puzzleProgress, kind: "puzzle", activationTime: puzzle.activationTime, timeClass: "pq-quest-puzzle-time" }) %>
        <div class="pq-quest-puzzle-solution">
          <span>
          <% if (puzzle.status >= 3) {%>
          <strong>Solution:</strong>&nbsp; <%= puzzle.puzzleDetail.solutionDisplayText %>
          <% } %>
          </span>
        </div>
      </div>
      <% }); %>
    </div>
    <script type="module" src="/script/quest.js"></script>
  </body>
</html>
