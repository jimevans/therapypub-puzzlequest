<%#
  One part of quest or puzzle progress (see QuestProgress), shown as hh:mm:ss.
  part is "elapsed", "penalty", or "total". data-duration holds milliseconds;
  while the clock runs, script/questProgress.js adds the time since
  data-clock-start and keeps the shown time current.
%>
<%
  const running = progress.running && part !== "penalty";
  const shownMs = { elapsed: progress.elapsedMs, penalty: progress.penaltyMs, total: progress.totalMs }[part];
  const baseMs = running ? shownMs - progress.elapsedMs : shownMs;
  const seconds = Math.trunc(shownMs / 1000);
  const pad = (n) => String(n).padStart(2, "0");
  const text = `${pad(Math.trunc(seconds / 3600))}:${pad(Math.trunc((seconds % 3600) / 60))}:${pad(seconds % 60)}`;
-%>
<span data-progress="<%= part %>" data-duration="<%= baseMs %>"<% if (running) { %> data-clock-start="<%= progress.startTime.toISOString() %>"<% } %>><%= text %></span>
