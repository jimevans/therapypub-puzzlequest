<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Reset your PuzzleQuest password</title>
    <link rel="stylesheet" type="text/css" href="/style/pq.css" />
    <link rel="icon" type="image/png" href="/image/pq-logo-64.png" sizes="64x64 32x32 24x24 16x16" />
    <link rel="icon" type="image/png" href="/image/pq-logo-192.png" sizes="192x192" />
  </head>
  <body>
    <div class="pq-header">
      <span class="pq-header-text">Forgot password</span>
    </div>
    <form id="forgot-form">
      <div class="pq-form-element">
        <div class="pq-label">
          Enter your user name or email address, and we'll email you a link to reset your password.
        </div>
      </div>
      <div class="pq-form-element">
        <div class="pq-label">
          <label for="identifier">User name or email:</label>
        </div>
        <div class="pq-input">
          <input id="identifier" autocomplete="username" />
        </div>
      </div>
      <div class="pq-form-element">
        <div>
          <button id="send" class="pq-button" type="submit">Send reset link</button>&nbsp;
          <button id="cancel" class="pq-button">Cancel</button>
        </div>
      </div>
      <div class="pq-error pq-hide">
        <span></span>
      </div>
    </form>
    <div id="sent" class="pq-form-element pq-hide">
      <div class="pq-label">
        If an account matches what you entered, we've sent it an email with a link to reset your password.
        The link expires in one hour.
      </div>
      <div class="pq-label">
        <a href="/login" class="pq-link">Return to sign in</a>
      </div>
    </div>
    <script type="module" src="/script/forgotPassword.js"></script>
  </body>
</html>
