# Copy to src/.env (which is git-ignored), or set these as environment variables.
# Environment variables take precedence over values in src/.env. The app checks
# these settings at startup and refuses to start if any are missing or invalid.

# "development" disables secure cookies and logs emails to the console when
# SMTP is not configured. Use any other value (e.g. "production") in production.
PQ_RUNTIME_ENVIRONMENT=development

# Port for the HTTP server (default 3000).
PQ_PORT=3000

PQ_MONGODB_URI=mongodb://localhost:27017/puzzlequest
# Signs session tokens. At least 32 characters; generate one with
# `openssl rand -base64 48`.
PQ_SECRET_KEY=replace-with-a-long-random-string

# Public base URL of the site, used to build links in emails.
PQ_BASE_URL=http://localhost:3000

# Set when running behind a reverse proxy (e.g. cPanel/Passenger) so rate
# limiting sees real client IPs. A hop count such as 1 is usually correct.
PQ_TRUST_PROXY=

# Outgoing email (password reset links). Leave PQ_SMTP_HOST empty in
# development to print emails to the console instead.
PQ_SMTP_HOST=
PQ_SMTP_PORT=587
# "true" for implicit TLS (usually port 465); otherwise STARTTLS is used.
PQ_SMTP_SECURE=false
PQ_SMTP_USER=
PQ_SMTP_PASSWORD=
PQ_EMAIL_FROM="PuzzleQuest <no-reply@example.com>"

# Twilio voice/SMS
PQ_TWILIO_ACCOUNT_SID=
PQ_TWILIO_AUTH_TOKEN=
PQ_TWILIO_MESSAGING_SERVICE_ID=
