{
  "name": "therapypub-puzzlequest",
  "version": "0.0.1",
  "description": "Therapy Pub and Co. PuzzleQuest website",
  "main": "dist/app.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && node node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimevans/therapypub-puzzlequest.git"
  },
  "author": "Therapy Pub and Co.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jimevans/therapypub-puzzlequest/issues"
  },
  "homepage": "https://github.com/jimevans/therapypub-puzzlequest#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.15",
    "marked": "^18.1.2",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "twilio": "^6.2.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  }
}
