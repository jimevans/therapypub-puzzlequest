{
  "name": "therapypub-puzzlequest",
  "version": "1.0.1",
  "description": "Therapy Pub and Co. PuzzleQuest website",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm start --workspace=@puzzlequest/api",
    "dev": "npm run dev --workspace=@puzzlequest/api",
    "dev:web": "npm run dev --workspace=@puzzlequest/web",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run build && npm run test:e2e --workspace=@puzzlequest/e2e",
    "generate:api": "npm run generate:api --workspace=@puzzlequest/api && npm run generate --workspace=@puzzlequest/api-client",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-native/bin/tsc -p . && npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed --workspace=@puzzlequest/api --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimevans/therapypub-puzzlequest.git"
  },
  "author": "Therapy Pub and Co.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jimevans/therapypub-puzzlequest/issues"
  },
  "homepage": "https://github.com/jimevans/therapypub-puzzlequest#readme",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "scarfSettings": {
    "enabled": false
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true,
    "geckodriver@8.0.0": true,
    "edgedriver": false,
    "@scarf/scarf": false,
    "fsevents": false
  }
}
