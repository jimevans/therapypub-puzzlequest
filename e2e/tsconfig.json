{
  // Type-checks the browser tests, which run under WebdriverIO, with its
  // globals (`npm run typecheck`).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"],
    "lib": ["es2023", "dom"]
  },
  "include": ["**/*.ts"]
}
