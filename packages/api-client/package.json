{
  "name": "@puzzlequest/api-client",
  "version": "0.0.1",
  "description": "A typed client for the PuzzleQuest API, generated from its OpenAPI description",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.0.5"
  }
}
