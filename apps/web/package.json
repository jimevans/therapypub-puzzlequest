{
  "name": "@puzzlequest/web",
  "version": "1.1.2",
  "description": "The PuzzleQuest website, built with React on the public API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p . && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.sw.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@puzzlequest/api-client": "*",
    "@tanstack/react-query": "^5.107.1",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "qrcode": "^1.5.4",
    "rolldown": "~1.3.1",
    "size-limit": "^14.3.0",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  }
}
