{
  // Browser code, which Vite bundles, so the base's Node settings don't apply.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  // The service worker runs where there's no page, so it's checked with its
  // own settings: see tsconfig.sw.json.
  "exclude": ["src/serviceWorker/sw.ts"]
}
