{
  // Compiles the server code in src/ to dist/, which production runs. The
  // type-checking settings come from tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"],
  // Browser scripts are served from src/public as-is.
  "exclude": ["src/public/**"]
}
