{
  // Type-checks the server code and its tests, which are TypeScript, and the
  // JavaScript configuration file here, from its JSDoc annotations.
  // tsconfig.build.json extends this to compile src/ to dist/.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "*.js"
  ],
  // Browser scripts read globals that each EJS page defines, so they are not
  // checked yet.
  "exclude": ["src/public/**"]
}
