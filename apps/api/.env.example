# Copy to src/.env (which is git-ignored), or set these as environment variables.
# Environment variables take precedence over values in src/.env. The app checks
# these settings at startup and refuses to start if any are missing or invalid.

# "development" disables secure cookies and logs emails to the console when
# SMTP is not configured. Use any other value (e.g. "production") in production.
PQ_RUNTIME_ENVIRONMENT=development

# Port for the HTTP server (default 3000).
PQ_PORT=3000

PQ_MONGODB_URI=mongodb://localhost:27017/puzzlequest

# Public base URL of the site, used to build links in emails and to check the
# signatures on Twilio webhooks. It must match the start of the webhook URLs
# set in the Twilio console exactly (scheme and host included).
PQ_BASE_URL=http://localhost:3000

# Set when running behind a reverse proxy (e.g. cPanel/Passenger) so rate
# limiting sees real client IPs. A hop count such as 1 is usually correct.
PQ_TRUST_PROXY=

# The least severe log entries kept: fatal, error, warn, info (the default),
# debug, or trace. The log is JSON lines on standard error; `npm run dev`
# shows it readably.
PQ_LOG_LEVEL=

# Outgoing email (password reset links). Leave PQ_SMTP_HOST empty in
# development to print emails to the console instead.
PQ_SMTP_HOST=
PQ_SMTP_PORT=587
# "true" for implicit TLS (usually port 465); otherwise STARTTLS is used.
PQ_SMTP_SECURE=false
PQ_SMTP_USER=
PQ_SMTP_PASSWORD=
PQ_EMAIL_FROM="PuzzleQuest <no-reply@example.com>"

# Twilio voice/SMS. Incoming calls and texts are rejected unless
# PQ_TWILIO_AUTH_TOKEN and PQ_BASE_URL are set, so their signatures can be
# checked.
PQ_TWILIO_ACCOUNT_SID=
PQ_TWILIO_AUTH_TOKEN=
PQ_TWILIO_MESSAGING_SERVICE_ID=

# Push notifications to the iOS app, through Apple's service (APNs). Set all
# four, or none, which turns sending to iPhones off. PQ_APNS_KEY is the
# contents of the .p8 key file from the Apple Developer account (Certificates,
# Identifiers & Profiles > Keys, with Apple Push Notifications service
# enabled), all of it from -----BEGIN PRIVATE KEY----- to -----END PRIVATE
# KEY-----; its line breaks may be written as \n. The server won't start with
# a key it can't read.
PQ_APNS_KEY=
PQ_APNS_KEY_ID=
PQ_APNS_TEAM_ID=
PQ_APNS_BUNDLE_ID=

# Push notifications to the Android app, through Firebase Cloud Messaging: the
# contents of a Firebase service account's JSON key file (Firebase console >
# Project settings > Service accounts > Generate new private key). Unset,
# sending to Android phones is off.
PQ_FCM_SERVICE_ACCOUNT=
