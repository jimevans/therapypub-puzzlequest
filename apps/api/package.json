{
  "name": "@puzzlequest/api",
  "version": "1.0.2",
  "description": "The PuzzleQuest server: the v1 API and the server-rendered pages",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/app.js",
    "dev": "tsx watch src/app.ts 2>&1 | pino-pretty",
    "generate:api": "tsx scripts/writeOpenApi.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p .",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.15",
    "marked": "^18.1.2",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.8",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.34.0",
    "twilio": "^6.2.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
